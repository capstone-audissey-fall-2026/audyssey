# ============================================================
# Audyssey 설정: 복사해서 .env로 씁니다. .env는 커밋하지 않습니다.
# 주석은 값 뒤가 아니라 윗줄에 적습니다 (줄 끝 주석이 값으로 읽힐 수 있음).
# ============================================================

# ---------- 1. 공통 ----------
# 앱과 도구 서버 사이 인증 토큰 (아무 무작위 문자열)
AUDYSSEY_TOOL_TOKEN=replace-with-a-random-token
# 이미지 버전: 비우면 latest, 공용 서버는 확인한 커밋 SHA로 고정 (docs/contributing.md)
AUDYSSEY_IMAGE_TAG=

# ---------- 2. Hugging Face (모델 가중치) ----------
# 게이트 모델은 Hugging Face에서 접근 승인 후 HF_CACHE에 받아 둡니다 (README 2.7)
HF_CACHE=/home/common/huggingface
AUDYSSEY_SAM_AUDIO_MODEL=facebook/sam-audio-large-tv
AUDYSSEY_SAM_AUDIO_JUDGE_MODEL=facebook/sam-audio-judge
AUDYSSEY_SAM3_MODEL=facebook/sam3.1

# ---------- 3. 도구 서버 (분리, 판정, 그라운딩, 생성) ----------
# GPU 번호가 같으면 한 GPU를 같이 씁니다
AUDYSSEY_SEPARATION_GPU=0
AUDYSSEY_JUDGE_GPU=0
AUDYSSEY_GROUNDING_GPU=0
AUDYSSEY_GENERATION_GPU=0
# AUDYSSEY_SAM_AUDIO_RERANKING_CANDIDATES=8
# Hydrogen AV 분리 설정을 쓸 때 함께 켭니다 (README의 실행 예시 참고).
# AUDYSSEY_SAM_AUDIO_CROP_PADDING_S=0.7
# AUDYSSEY_SAM_AUDIO_BATCH_SIZE=4
# AUDYSSEY_SAM_AUDIO_ALLOW_TF32=true
# 도구 서버를 RunPod 등 외부에 둘 때 (생성은 현재 RunPod 구성에 없음)
# AUDYSSEY_SEPARATOR_URL=https://your-pod-8700.proxy.runpod.net
# AUDYSSEY_FILTER_URL=https://your-pod-8700.proxy.runpod.net
# AUDYSSEY_GROUNDING_URL=https://your-pod-8700.proxy.runpod.net
# AUDYSSEY_GENERATOR=stub

# ---------- 4. 플래너 / 검수기 LLM ----------
# 아무것도 켜지 않으면 Compose 안의 vllm(Qwen2.5-VL-3B)을 프레임 입력으로 씁니다 (키 불필요).
# 다른 모델은 A, B, C 중 하나를 켭니다.
# 검수기(AUDYSSEY_VALIDATOR_*)는 비워 두면 플래너와 같은 모델을 씁니다.
# 검수기만 다르게 하려면 블록을 PLANNER -> VALIDATOR로 바꿔 적습니다 (키도 함께).
# 검수에는 오디오 검수와 시각 검수 두 방식이 있습니다. docs/planning.md 참고.
# 검수 모델이 오디오 입력을 받으면 true(오디오 검수), 받지 못하면 false(시각 검수).
# 비워 두면 INPUT=video + VIDEO_AUDIO=true일 때만 오디오 검수를 씁니다.
# AUDYSSEY_VALIDATOR_AUDIO=true
# AUDYSSEY_VALIDATOR_CONTEXT_S=0.5
# 분리 검수는 기본으로 오디오만 전달합니다. 영상+오디오와 비교하려면 false로 바꿉니다.
# AUDYSSEY_VALIDATOR_AUDIO_ONLY=true
# 자세한 설명: docs/running.md#플래너-연결-gemini-vllm

# A. Gemini SDK (Google 키, Compose가 GOOGLE_API_KEY를 AUDYSSEY_PLANNER_API_KEY로 넘김)
# AUDYSSEY_PLANNER_API=gemini
# AUDYSSEY_PLANNER_MODEL=gemini-3.8-flash
# GOOGLE_API_KEY=
# AUDYSSEY_PLANNER_INPUT=video
# AUDYSSEY_PLANNER_VIDEO_AUDIO=true
# AUDYSSEY_PLANNER_FPS=2

# B. OpenRouter (OpenRouter 키). 영상 속 소리는 전달되고, fps는 지정할 수 없어 1fps로 고정
# AUDYSSEY_PLANNER_API=openrouter
# AUDYSSEY_PLANNER_BASE_URL=https://openrouter.ai/api/v1
# AUDYSSEY_PLANNER_MODEL=google/gemini-3.8-flash
# Hydrogen AV 분리를 쓸 때 위 MODEL을 google/gemini-4-hydrogen으로 바꿉니다.
# AUDYSSEY_PLANNER_STRICT_AUDIO=true
# AUDYSSEY_PLANNER_API_KEY=
# AUDYSSEY_PLANNER_INPUT=video
# AUDYSSEY_PLANNER_VIDEO_AUDIO=true

# C. vLLM (Compose 안의 vllm, 개인 Pod면 주소를 http://<pod 주소>:8000/v1로)
# AUDYSSEY_PLANNER_API=openai
# AUDYSSEY_PLANNER_BASE_URL=http://vllm:8000/v1
# AUDYSSEY_PLANNER_MODEL=Qwen/Qwen3-VL-8B-Instruct
# AUDYSSEY_PLANNER_API_KEY=unused
# AUDYSSEY_PLANNER_INPUT=video
# AUDYSSEY_PLANNER_FPS=2

# 생성 모드의 이미지 검수기 예: 플래너는 A, 검수기는 Compose 안의 vllm
# AUDYSSEY_VALIDATOR_API=openai
# AUDYSSEY_VALIDATOR_BASE_URL=http://vllm:8000/v1
# AUDYSSEY_VALIDATOR_MODEL=Qwen/Qwen3-VL-8B-Instruct
# AUDYSSEY_VALIDATOR_API_KEY=unused
# AUDYSSEY_VALIDATOR_FPS=5

# Compose 안의 vllm 서버 (캐시에 모델이 있어야 함)
AUDYSSEY_VLLM_MODEL=Qwen/Qwen2.5-VL-3B-Instruct
AUDYSSEY_VLLM_GPU=0
# vllm이 쓸 GPU 메모리 비율. 도구와 GPU 0 한 장을 나눠 쓰면 0.2, vllm 혼자 쓰면 0.85 정도
AUDYSSEY_VLLM_GPU_UTIL=0.2

# ---------- 5. LangSmith 추적 (선택) ----------
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=audyssey
